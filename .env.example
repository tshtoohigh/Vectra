# Vectra — Environment Variables for Netlify
#
# Add these in Netlify: Site Configuration → Environment Variables
# Uses MY_AWS_ prefix because Netlify reserves AWS_* names
#
# Get credentials from: Learner Lab → AWS Details → Show

# === AWS Credentials (server-side, safe) ===
MY_AWS_ACCESS_KEY_ID=
MY_AWS_SECRET_ACCESS_KEY=
MY_AWS_SESSION_TOKEN=
MY_AWS_REGION=us-east-1
MY_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:037389780625:PolyTrackAlerts

# === AI (client-side) ===
VITE_OPENROUTER_API_KEY=
