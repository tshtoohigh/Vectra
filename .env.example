# PolyTrack — AWS Environment Variables
#
# Copy this file to `.env` and fill in your Learner Lab credentials.
# Get these from: Learner Lab → AWS Details → Show (next to AWS CLI)
#
# ⚠️  These credentials rotate every time you restart your lab session!
#     You'll need to update them each time.
#
# For Netlify: add these in Site Configuration → Environment Variables

# === REQUIRED: AWS Credentials (from Learner Lab) ===
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=
VITE_AWS_SESSION_TOKEN=

# === REQUIRED: AI (OpenRouter — free, for bonus marks) ===
VITE_OPENROUTER_API_KEY=

# === OPTIONAL ===
# Region (defaults to us-east-1)
VITE_AWS_REGION=us-east-1

# SNS Topic ARN (defaults to your PolyTrackAlerts topic)
VITE_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:037389780625:PolyTrackAlerts
