# PolyTrack — frontend environment variables
#
# The app runs fully without any of these: the AWS service modules in
# src/services/aws/ fall back to local mock implementations so the demo works
# offline. Fill these in when you point it at real infrastructure.
#
# Copy to `.env` (which is gitignored) and restart the dev server.

# API Gateway base URL, e.g. https://abc123.execute-api.ap-southeast-1.amazonaws.com/prod
# Leave blank to keep using local mock data.
VITE_API_URL=

# Amazon Cognito user pool (see src/services/aws/cognitoAuth.js)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
