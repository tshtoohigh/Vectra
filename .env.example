# Vectra — Environment Variables for Netlify
#
# Add these in Netlify: Site Configuration → Environment Variables
# The AWS vars do NOT have VITE_ prefix (they stay server-side, never in browser)
#
# Get AWS credentials from: Learner Lab → AWS Details → Show

# === AWS Credentials (server-side only — safe!) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:037389780625:PolyTrackAlerts

# === AI (client-side — needs VITE_ prefix) ===
VITE_OPENROUTER_API_KEY=
